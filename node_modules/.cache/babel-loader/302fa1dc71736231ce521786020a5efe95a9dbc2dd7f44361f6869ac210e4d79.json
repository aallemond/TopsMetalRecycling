{"ast":null,"code":"import{useEffect,useState}from\"react\";import{supabase}from\"../lib/supabase\";export default function useScrapPrices(){const[prices,setPrices]=useState(null);useEffect(()=>{async function fetchPrices(){try{const{data,error}=await supabase.from(\"scrap_prices\").select(\"*\").order(\"display_order\",{ascending:true});if(!error&&data){setPrices(data);}}catch(err){console.error(\"Fetch failed:\",err);}}fetchPrices();},[]);return prices;}","map":{"version":3,"names":["useEffect","useState","supabase","useScrapPrices","prices","setPrices","fetchPrices","data","error","from","select","order","ascending","err","console"],"sources":["/Users/andrewallemond/Desktop/tops/TopsMetalRecycling/src/hooks/useScrapPrices.js"],"sourcesContent":["import { useEffect, useState } from \"react\";\nimport { supabase } from \"../lib/supabase\";\n\nexport default function useScrapPrices() {\n  const [prices, setPrices] = useState(null);\n\n  useEffect(() => {\n\n    async function fetchPrices() {\n      try {\n        const { data, error } = await supabase\n          .from(\"scrap_prices\")\n          .select(\"*\")\n          .order(\"display_order\", { ascending: true });\n\n        if (!error && data) {\n          setPrices(data);\n        }\n      } catch (err) {\n        console.error(\"Fetch failed:\", err);\n      }\n    }\n\n    fetchPrices();\n\n  }, []);\n\n  return prices;\n}"],"mappings":"AAAA,OAASA,SAAS,CAAEC,QAAQ,KAAQ,OAAO,CAC3C,OAASC,QAAQ,KAAQ,iBAAiB,CAE1C,cAAe,SAAS,CAAAC,cAAcA,CAAA,CAAG,CACvC,KAAM,CAACC,MAAM,CAAEC,SAAS,CAAC,CAAGJ,QAAQ,CAAC,IAAI,CAAC,CAE1CD,SAAS,CAAC,IAAM,CAEd,cAAe,CAAAM,WAAWA,CAAA,CAAG,CAC3B,GAAI,CACF,KAAM,CAAEC,IAAI,CAAEC,KAAM,CAAC,CAAG,KAAM,CAAAN,QAAQ,CACnCO,IAAI,CAAC,cAAc,CAAC,CACpBC,MAAM,CAAC,GAAG,CAAC,CACXC,KAAK,CAAC,eAAe,CAAE,CAAEC,SAAS,CAAE,IAAK,CAAC,CAAC,CAE9C,GAAI,CAACJ,KAAK,EAAID,IAAI,CAAE,CAClBF,SAAS,CAACE,IAAI,CAAC,CACjB,CACF,CAAE,MAAOM,GAAG,CAAE,CACZC,OAAO,CAACN,KAAK,CAAC,eAAe,CAAEK,GAAG,CAAC,CACrC,CACF,CAEAP,WAAW,CAAC,CAAC,C